# Variables de compilation du front, à définir chez l'hébergeur.
#
# Vite les remplace dans le code au moment du build : elles ne sont pas lues à
# l'exécution. Changer une adresse impose donc un nouveau déploiement, et tout
# ce qui figure ici se retrouve en clair dans le JavaScript livré — aucun
# secret ne doit y apparaître.
VITE_API_URL=https://api.booking.ma
VITE_KEYCLOAK_URL=https://auth.booking.ma
VITE_KEYCLOAK_REALM=booking-realm
VITE_KEYCLOAK_CLIENT_ID=booking-app
